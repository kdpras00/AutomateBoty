# ── AutomateBoty Backend — Environment Template ────────────────────────────────
# Salin file ini menjadi `.env` di folder `backend/` lalu isi nilainya.

# WAJIB: Google Gemini API Key (dari https://aistudio.google.com/app/apikey)
# Kunci ini TIDAK PERNAH dikirim ke browser — hanya dipakai di sisi server.
GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE

# Opsional: port server (default 3000)
PORT=3000

# Opsional: origin yang diizinkan CORS (pisahkan dengan koma bila lebih dari satu)
# Default: https://automateboty.netlify.app
ALLOWED_ORIGIN=https://automateboty.netlify.app

# Opsional: batas request per menit per IP (default 30)
RATE_LIMIT_MAX=30
